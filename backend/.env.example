# Environment Variables for Mindshift Backend
# Copy this to .env and fill in your values

# Database
DATABASE_URL="postgresql://mindshift:mindshift_dev@localhost:5432/mindshift"

# JWT Secrets (change these in production!)
ACCESS_TOKEN_SECRET="mindshift_access_secret_change_in_prod"
REFRESH_TOKEN_SECRET="mindshift_refresh_secret_change_in_prod"

# Server
PORT=3000
NODE_ENV=development

# CORS - frontend origin
CORS_ORIGIN="http://localhost:8081"

# Token expiry
ACCESS_TOKEN_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY="7d"
